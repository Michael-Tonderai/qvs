# .env.example
#
# The variables config/settings.py reads, with no values.
#
# REQ-N-002: no secret, key or credential is committed. .gitignore excludes .env and
# .env.* but explicitly re-includes this file, so a fresh clone can see WHICH
# variables are required without ever seeing what they hold.
#
# Copy to .env and fill in. Nothing reads .env automatically yet - variables are set
# in the shell for local work and by docker compose in the container.

# 1 for development, 0 everywhere else. When it is not 1, a missing QVS_SECRET_KEY is
# a start-up error rather than a generated throwaway.
QVS_DEBUG=1

# Django's SECRET_KEY. Generate with:
#   .\.venv\Scripts\python.exe -c "import secrets; print(secrets.token_urlsafe(50))"
QVS_SECRET_KEY=

# D-003: the HMAC-SHA256 key that signs qualification records. Changing it invalidates
# every signature already issued, so it is generated once and kept.
QVS_SIGNING_KEY=

# Comma separated. Defaults to localhost,127.0.0.1 when unset.
QVS_ALLOWED_HOSTS=localhost,127.0.0.1

# D-002: absolute or relative path to the SQLite file. Defaults to db.sqlite3 at the
# repository root; the container points it at a mounted volume.
QVS_DATABASE_PATH=
